rules_version = '2';

// Mensagens do formulário do portfólio: qualquer visitante pode ENVIAR (create),
// ninguém pode ler, alterar ou apagar pelo site. Você lê no Console do Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    match /mensagens/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'origem', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]{2,}')
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 4000
        && request.resource.data.origem == 'portfolio'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
